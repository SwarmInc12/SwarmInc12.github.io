       "field": "days",
       "triggerAtHour": 7
      }
     ]
    }
   },
   "id": "1cbbad7d-2640-532f-9fb2-2d2c87b11a8f",
   "name": "Each morning",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    140,
    0
   ]
