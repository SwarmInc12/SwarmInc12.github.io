  {
   "parameters": {
    "jsCode": "// One API call a filter, each morning. Add an object per filter; the parameters: country, cpv_prefix, keyword.\nconst filters = [{\"cpv_prefix\": \"72\", \"country\": \"FRA\"}];\n// published_since: the day before the run, so each morning brings what was published since the last one (repeats are matched on notice_id).\nconst since = $now.minus({ days: 1 }).toFormat('yyyyMMdd');\nreturn filters.map((f) => ({ json: { ...f, published_since: since, limit: 100, src: 'n8n-ted-tender-monitor' } }));"
   },
