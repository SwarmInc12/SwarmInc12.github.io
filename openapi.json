  "/v1/fr-company-search": {
   "get": {
    "summary": "French Company Search (Recherche d'entreprises, Sirene)",
    "description": "Search France's official company register by NAF activity code, d\u00e9partement, headcount band and status, and get typed legal-entity records with head-office address, coordinates and company size.",
    "operationId": "fr_company_search",
    "parameters": [
     {
      "name": "activite_principale",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "62.01Z"
      },
      "description": "Main activity code (NAF rev. 2) of the company, e.g. 62.01Z (computer programming), 56.10A (restaurants), 47.11D (supermarkets).",
      "example": "62.01Z"
     },
     {
      "name": "departement",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "D\u00e9partement code of the head office, e.g. 75 Paris, 69 Rh\u00f4ne, 2A Corse-du-Sud. Leave empty for all of France.",
      "example": "75"
     },
     {
      "name": "tranche_effectif_salarie",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string"
      },
      "description": "INSEE headcount band: 00 (0), 01 (1-2), 02 (3-5), 03 (6-9), 11 (10-19), 12 (20-49), 21 (50-99), 22 (100-199), 31 (200-249), 32 (250-499), 41 (500-999), 42 (1000-1999), 51 (2000-4999), 52 (5000-9999), 53 (10000+). Leave empty for any.",
      "example": "11"
     },
     {
      "name": "etat_administratif",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "A",
        "C"
       ],
       "default": "A"
      },
      "description": "A = active companies, C = ceased companies.",
