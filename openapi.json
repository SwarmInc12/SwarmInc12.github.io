  "/v1/ted-tender-monitor": {
   "get": {
    "summary": "EU Public Tender Monitor (TED)",
    "description": "New public procurement notices from the EU's official TED search API for a CPV code prefix, buyer country and keyword, returning only the notices that are new or changed since your last run.",
    "operationId": "ted_tender_monitor",
    "parameters": [
     {
      "name": "cpv_prefix",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "72"
      },
      "description": "Start of the CPV code to follow (for example 72 for IT services, 45 for construction, 33 for medical equipment).",
      "example": "72"
     },
     {
      "name": "country",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "AUT",
        "BEL",
        "BGR",
        "HRV",
        "CYP",
        "CZE",
        "DNK",
        "EST",
        "FIN",
        "FRA",
        "DEU",
        "GRC",
        "HUN",
        "IRL",
        "ITA",
        "LVA",
        "LTU",
        "LUX",
        "MLT",
        "NLD",
        "POL",
        "PRT",
        "ROU",
        "SVK",
        "SVN",
        "ESP",
        "SWE",
        "NOR",
        "ISL"
       ],
       "default": "FRA"
      },
      "description": "Country of the buying organisation, as a three-letter ISO code.",
      "example": "FRA"
