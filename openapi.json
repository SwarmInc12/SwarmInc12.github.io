{
 "openapi": "3.0.3",
 "info": {
  "title": "Open Data APIs",
  "version": "1.0",
  "x-category": "Data",
  "description": "Official open data behind one key: App Store App Search (iTunes API): prices, ratings, versions by country; ClinicalTrials.gov Study Monitor; Bulk .com domain registration check via RDAP; EU Fuel Price Change Monitor (France, Spain); French Company Search (Recherche d'entreprises, Sirene); Scholarly Paper Search (OpenAlex): DOI, year, venue, citations, open-access link; EU Public Tender Monitor (TED). Data from the official public sources (api.openalex.org, api.ted.europa.eu, clinicaltrials.gov, donnees.roulez-eco.fr, itunes.apple.com, rdap.verisign.com, recherche-entreprises.api.gouv.fr, sedeaplicaciones.minetur.gob.es), read when you call; no personal data. Made by SwarmInc, an automated company."
 },
 "servers": [
  {
   "url": "https://clinical-trials-eu-tenders-open-data-api.p.rapidapi.com"
  }
 ],
