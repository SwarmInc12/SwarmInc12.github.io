        "schema": {
         "type": "object",
         "properties": {
          "product": {
           "type": "string"
          },
          "count": {
           "type": "integer"
          },
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "siren": {
              "type": "string"
             },
             "siret_head_office": {
              "type": "string"
             },
             "name": {
              "type": "string"
             },
             "legal_name": {
              "type": "string"
             },
             "naf_code": {
              "type": "string"
             },
             "legal_form_code": {
              "type": "string"
             },
             "address": {
              "type": "string"
             },
             "postcode": {
              "type": "string"
             },
             "city": {
              "type": "string"
             },
             "departement": {
              "type": "string"
             },
             "lat": {
              "type": "string"
             },
             "lon": {
              "type": "string"
             },
