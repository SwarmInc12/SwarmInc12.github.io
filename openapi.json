  "/v1/clinical-trials-monitor": {
   "get": {
    "summary": "ClinicalTrials.gov Study Monitor",
    "description": "Studies from the official ClinicalTrials.gov API v2 for a condition, phase and status, returning only the studies whose status, phase, enrollment or last update changed since your last run.",
    "operationId": "clinical_trials_monitor",
    "parameters": [
     {
      "name": "condition",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "breast cancer"
      },
      "description": "Disease or condition to follow (for example breast cancer, type 2 diabetes, Alzheimer).",
      "example": "breast cancer"
     },
     {
      "name": "phase",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "EARLY_PHASE1",
        "PHASE1",
        "PHASE2",
        "PHASE3",
        "PHASE4"
       ],
       "default": "PHASE2"
      },
      "description": "Study phase to follow.",
      "example": "PHASE2"
     },
     {
      "name": "status",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "RECRUITING",
        "NOT_YET_RECRUITING",
        "ACTIVE_NOT_RECRUITING",
        "ENROLLING_BY_INVITATION",
        "COMPLETED",
        "TERMINATED",
        "WITHDRAWN",
        "SUSPENDED"
       ],
       "default": "RECRUITING"
      },
      "description": "Recruitment status to follow.",
      "example": "RECRUITING"
     },
     {
      "name": "updated_since",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "2025-01-01"
      },
      "description": "Only studies whose record was last updated on or after this date (YYYY-MM-DD).",
      "example": "2025-01-01"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000,
       "default": 100
      },
      "description": "At most this many results (1-1000)."
     }
    ],
    "responses": {
     "200": {
      "description": "The results",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "product": {
           "type": "string"
          },
          "count": {
           "type": "integer"
          },
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "nct_id": {
              "type": "string"
             },
             "title": {
              "type": "string"
             },
             "sponsor": {
              "type": "string"
             },
             "phase": {
              "type": "array",
              "items": {}
             },
             "status": {
              "type": "string"
             },
             "enrollment": {
              "type": "integer"
             },
             "start_date": {
              "type": "string"
             },
             "completion_date": {
              "type": "string"
             },
             "last_update_date": {
              "type": "string"
             },
             "conditions": {
              "type": "array",
              "items": {}
             },
             "lead_intervention": {
              "type": "string"
             },
             "first_country": {
              "type": "string"
             }
            }
           }
          }
         }
        }
       }
      }
     },
     "400": {
      "description": "A parameter the product doesn't take, or a value of the wrong type"
     },
     "429": {
      "description": "Too many requests"
     },
     "502": {
      "description": "The source didn't answer"
     }
    }
   }
  },
  "/v1/domain-availability": {
