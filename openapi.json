        "schema": {
         "type": "object",
         "properties": {
          "count": {
           "type": "integer"
          },
          "products": {
           "type": "array",
           "items": {
            "type": "object"
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/v1/app-store-search": {
   "get": {
    "summary": "App Store App Search (iTunes API): prices, ratings, versions by country",
    "description": "Search Apple's App Store by keyword in any storefront country and get each app's developer, price, rating, version, release date, genre, size, minimum OS and store URL.",
    "operationId": "app_store_search",
    "parameters": [
     {
      "name": "term",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "default": "budget"
      },
      "description": "Keyword to search for in the App Store (for example budget, photo editor, meditation).",
      "example": "budget"
     },
     {
      "name": "country",
      "in": "query",
      "required": false,
      "schema": {
       "type": "string",
       "enum": [
        "us",
        "gb",
        "ca",
        "au",
        "nz",
        "ie",
        "fr",
        "de",
        "es",
        "it",
        "pt",
        "nl",
        "be",
        "at",
        "ch",
        "se",
        "no",
        "dk",
        "fi",
        "pl",
        "cz",
        "tr",
        "gr",
        "jp",
        "kr",
        "cn",
        "hk",
        "tw",
        "sg",
        "in",
        "id",
        "th",
        "vn",
        "ph",
        "my",
        "br",
        "mx",
        "ar",
        "cl",
        "co",
        "za",
        "ae",
        "sa",
        "il",
        "eg",
        "ng",
        "ua",
        "ro",
        "hu"
       ],
       "default": "us"
      },
      "description": "Two-letter App Store country code, which sets the prices, currency and ratings returned.",
      "example": "us"
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "default": 50
      },
      "description": "How many apps to return (Apple allows up to 200 per search).",
      "example": 50
     }
    ],
    "responses": {
     "200": {
      "description": "The results",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "product": {
           "type": "string"
          },
          "count": {
           "type": "integer"
          },
          "items": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "app_id": {
              "type": "string"
             },
             "name": {
              "type": "string"
             },
             "developer": {
              "type": "string"
             },
             "developer_id": {
              "type": "string"
             },
             "bundle_id": {
              "type": "string"
             },
             "price": {
              "type": "number"
             },
             "formatted_price": {
              "type": "string"
             },
             "currency": {
              "type": "string"
             },
             "average_rating": {
              "type": "number"
             },
             "rating_count": {
              "type": "integer"
             },
             "average_rating_current_version": {
              "type": "number"
             },
             "rating_count_current_version": {
              "type": "integer"
             },
             "version": {
              "type": "string"
             },
             "version_release_date": {
              "type": "string"
             },
             "release_date": {
              "type": "string"
             },
             "primary_genre": {
              "type": "string"
             },
             "size_bytes": {
              "type": "integer"
             },
             "minimum_os": {
              "type": "string"
             },
             "content_rating": {
              "type": "string"
             },
             "seller_name": {
              "type": "string"
             },
             "store_url": {
